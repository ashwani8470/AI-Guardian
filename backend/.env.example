# Copy this file to .env and fill in your real values. Never commit .env itself.

# postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_guardian_ind
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_guardian

# Any random long string. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-something-random-and-long

# Frontend URL (used in the password-reset email link)
FRONTEND_BASE_URL=http://localhost:5173

# Browser origins allowed to call the API (comma-separated). Add another port if Vite uses one.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMTP for password-reset emails. Gmail: smtp.gmail.com / 587 / your address / 16-char App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AI Guardian

# Optional: full path to tesseract.exe if it is not in the default Windows location
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Sample (guest) mode: free example scans allowed without an account (across all features)
DEMO_SCAN_LIMIT=3
