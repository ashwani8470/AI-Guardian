# Copy this file to .env and fill in your real values. Never commit .env itself.

# Once PostgreSQL is installed and you've created the database, it'll look like:
# postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_guardian
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_guardian

# Any random long string works for local dev. Generate one properly before any real deploy.
SECRET_KEY=change-this-to-something-random-and-long
